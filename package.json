{
  "name": "agent-eval-lab",
  "version": "0.1.0",
  "description": "Evaluate a local project's command checks and Git changes with honest, portable reports.",
  "type": "module",
  "bin": { "agent-eval-lab": "dist/cli/index.js" },
  "files": ["dist", "docs/report.schema.json", "README.md", "LICENSE"],
  "engines": { "node": ">=22.12.0" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Jebipro/agent-eval-lab.git" },
  "homepage": "https://github.com/Jebipro/agent-eval-lab#readme",
  "bugs": { "url": "https://github.com/Jebipro/agent-eval-lab/issues" },
  "keywords": ["cli", "evaluation", "coding-agent", "testing", "git"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/finish-build.mjs",
    "test": "npm run build && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:package": "node scripts/test-package.mjs",
    "examples": "npm run build && node scripts/examples.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "jsonc-parser": "3.3.1",
    "minimatch": "10.2.4",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
