{
  "name": "agent-eval-report-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-validator.mjs && node scripts/generate-examples.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "node scripts/run-tests.mjs public unit",
    "test:local": "node scripts/run-tests.mjs private unit",
    "build": "npm run generate && npm run verify:fixtures && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "npm run build && node scripts/run-tests.mjs public browser",
    "test:browser:local": "npm run build && node scripts/run-tests.mjs private browser",
    "verify:local": "npm run generate && node scripts/verify-fixtures.mjs --private"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
